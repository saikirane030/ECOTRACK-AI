# EcoTrack AI – Environment Variable Template
#
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file to GitHub.
#
# How to get these values:
# 1. Create a free IBM Cloud account at https://cloud.ibm.com
# 2. Create a watsonx.ai Studio instance (Lite plan is free)
# 3. Create a project inside watsonx.ai Studio
# 4. Generate an IBM Cloud API key at:
#    https://cloud.ibm.com/iam/apikeys
# 5. Copy your Project ID from the project settings page

# --- Required for the AI Assistant (Tab 3) ---
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Region where your watsonx.ai instance is hosted.
# Common values: us-south, eu-de, au-syd, jp-tok
WATSONX_REGION=us-south

# --- Optional: Required only for Waste Image Analyzer AI Mode (Tab 1) ---
# The granite-vision model requires a dedicated "deploy on demand" deployment.
# If this is blank, Tab 1 will automatically use Demo Mode.
# See README.md for instructions on how to create a vision deployment.
WATSONX_VISION_DEPLOYMENT_ID=
