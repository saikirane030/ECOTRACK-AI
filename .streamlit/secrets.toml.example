# .streamlit/secrets.toml
#
# LOCAL DEVELOPMENT ONLY — never commit this file with real values.
# This file is listed in .gitignore.
#
# For Streamlit Cloud deployment, enter these same keys in:
#   App Settings → Secrets (on share.streamlit.io)
#
# Copy this file, rename it to secrets.toml, and fill in your real values:

WATSONX_API_KEY = "your_ibm_cloud_api_key_here"
WATSONX_PROJECT_ID = "your_watsonx_project_id_here"
WATSONX_REGION = "us-south"

# Optional — only needed to enable Vision AI in Tab 1
# Leave blank to use Demo Mode (free, no deployment required)
WATSONX_VISION_DEPLOYMENT_ID = ""
